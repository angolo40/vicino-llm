<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Keep CPU alive with screen off while serving requests -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service (Phase 2+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Runtime-requested on Android 13+. Without it the persistent
         notification is suppressed and the foreground service looks broken. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery optimization whitelist. On Samsung / OneUI this is the
         difference between "service survives" and "service gets killed by
         lmkd every 20 minutes". We ask the user to grant it explicitly from
         the Permissions screen. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phase 3: scan /sdcard/Models/ for *.litertlm. On Android 11+ this
         requires MANAGE_EXTERNAL_STORAGE. Declared but not requested by
         default — the user grants it manually if they want /sdcard/Models,
         otherwise the app falls back to /sdcard/Android/data/<pkg>/files/. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".GemmaServerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GemmaServer">

        <!-- Required for LiteRT-LM GPU backend on Android. required="false" so
             the app still installs on devices without OpenCL (falls back to CPU). -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local LLM HTTP server for LAN use" />
        </service>

    </application>

</manifest>
